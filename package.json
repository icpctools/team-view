{
	"name": "team",
	"version": "0.8.0-next",
	"license": "MIT",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "pnpm build:packages && vite dev",
		"build": "pnpm build:packages && vite build",
		"build:packages": "pnpm --filter '@icpctools/*' build",
		"preview": "vite preview",
		"test": "npm run test:unit && npm run test:integration",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config vite.config.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config vite.config.ts --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.10.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.13.3",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"jszip": "^3.10.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@icpctools/contest-api": "workspace:*",
		"@icpctools/contest-ui": "workspace:*",
		"@monaco-editor/loader": "^1.7.0",
		"i18n-iso-countries": "^7.14.0",
		"mode-watcher": "^1.1.0",
		"monaco-editor": "^0.55.1",
		"mpegts.js": "1.8.0",
		"video.js": "^8.23.9",
		"videojs-mpegtsjs": "^1.0.0"
	},
	"packageManager": "pnpm@11.15.1+sha512.gTULB+U8lTigLx8jA7QpD6LXvgTlbiqXDEzEtBfcdh3hlu2r1J1Vx9yVgNuBAHxEFD5OPX5GKzAA0jwlUSLQZQ=="
}
