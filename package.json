{
	"name": "team",
	"version": "0.10.0-next",
	"license": "MIT",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "pnpm build:packages && vite dev",
		"build": "pnpm build:packages && vite build",
		"build:packages": "pnpm --filter '@icpctools/*' build",
		"preview": "vite preview",
		"test": "npm run test:unit && npm run test:integration",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config vite.config.ts && pnpm --filter '@icpctools/*' check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config vite.config.ts --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@monaco-editor/loader": "^1.7.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.19.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.14.0",
		"jszip": "^3.10.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"video.js": "^8.24.2",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@icpctools/contest-api": "workspace:*",
		"@icpctools/contest-ui": "workspace:*",
		"i18n-iso-countries": "^7.14.0",
		"mode-watcher": "^1.1.0",
		"monaco-editor": "^0.55.1",
		"mpegts.js": "1.8.0",
		"videojs-mpegtsjs": "^1.0.0"
	},
	"packageManager": "pnpm@12.4.2+sha512-CK3GYTGAJ1x8ntraOdzwjJxhrU5+rzMKTzRh8QKw+QdCNFTRF/mOctR/7wYWBwZE17/8lzpqV/UJCm18NosHyQ==",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
