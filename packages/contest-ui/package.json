{
	"name": "@icpctools/contest-ui",
	"version": "0.8.0-next",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"publishConfig": {
		"provenance": true,
		"access": "public"
	},
	"typesVersions": {
		"*": {
			"*": [
				"./src/index.ts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./Clock": {
			"types": "./dist/Clock.svelte.d.ts",
			"svelte": "./dist/Clock.svelte"
		},
		"./Image": {
			"types": "./dist/Image.svelte.d.ts",
			"svelte": "./dist/Image.svelte"
		},
		"./FloorMap": {
			"types": "./dist/FloorMap.svelte.d.ts",
			"svelte": "./dist/FloorMap.svelte"
		},
		"./JudgementTypeUI": {
			"types": "./dist/JudgementTypeUI.svelte.d.ts",
			"svelte": "./dist/JudgementTypeUI.svelte"
		},
		"./JudgementUI": {
			"types": "./dist/JudgementUI.svelte.d.ts",
			"svelte": "./dist/JudgementUI.svelte"
		},
		"./Problem": {
			"types": "./dist/Problem.svelte.d.ts",
			"svelte": "./dist/Problem.svelte"
		},
		"./Video": {
			"types": "./dist/Video.svelte.d.ts",
			"svelte": "./dist/Video.svelte"
		},
		"./Logo": {
			"types": "./dist/Logo.svelte.d.ts",
			"svelte": "./dist/Logo.svelte"
		},
		"./Person": {
			"types": "./dist/Person.svelte.d.ts",
			"svelte": "./dist/Person.svelte"
		}
	},
	"scripts": {
		"test": "vitest",
		"build": "svelte-package",
		"watch": "svelte-package -w",
		"svelte:check": "svelte-check --tsconfig ./tsconfig.json",
		"publish:next": "pnpm publish  --registry=https://registry.npmjs.org/ --no-git-tag-version --new-version 0.0.1-\"$(date +%s)\""
	},
	"files": [
		"dist",
		"!dist/**/*.spec.*",
		"tsconfig.json"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.2.0",
		"@icpctools/contest-api": "workspace:*",
		"mpegts.js": "^1.8.0",
		"video.js": "^8.23.7",
		"videojs-mpegtsjs": "^1.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.2.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.12.2",
		"jsdom": "^28.1.0",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.2.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
