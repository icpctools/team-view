{
	"name": "@icpctools/contest-ui",
	"version": "0.8.0-next",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/icpctools/team-view.git",
		"directory": "packages/contest-ui"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"provenance": true,
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./Clock": {
			"types": "./dist/Clock.svelte.d.ts",
			"svelte": "./dist/Clock.svelte"
		},
		"./Image": {
			"types": "./dist/Image.svelte.d.ts",
			"svelte": "./dist/Image.svelte"
		},
		"./FloorMap": {
			"types": "./dist/FloorMap.svelte.d.ts",
			"svelte": "./dist/FloorMap.svelte"
		},
		"./JudgementTypeUI": {
			"types": "./dist/JudgementTypeUI.svelte.d.ts",
			"svelte": "./dist/JudgementTypeUI.svelte"
		},
		"./JudgementUI": {
			"types": "./dist/JudgementUI.svelte.d.ts",
			"svelte": "./dist/JudgementUI.svelte"
		},
		"./ProblemUI": {
			"types": "./dist/ProblemUI.svelte.d.ts",
			"svelte": "./dist/ProblemUI.svelte"
		},
		"./Video": {
			"types": "./dist/Video.svelte.d.ts",
			"svelte": "./dist/Video.svelte"
		},
		"./Logo": {
			"types": "./dist/Logo.svelte.d.ts",
			"svelte": "./dist/Logo.svelte"
		},
		"./PersonUI": {
			"types": "./dist/PersonUI.svelte.d.ts",
			"svelte": "./dist/PersonUI.svelte"
		},
		"./colors": {
			"types": "./dist/colors.d.ts",
			"default": "./dist/colors.js"
		}
	},
	"scripts": {
		"test": "vitest",
		"build": "svelte-package",
		"watch": "svelte-package -w",
		"svelte:check": "svelte-check --tsconfig ./tsconfig.json",
		"publish:next": "pnpm publish  --registry=https://registry.npmjs.org/ --no-git-tag-version --new-version 0.0.1-\"$(date +%s)\""
	},
	"files": [
		"dist",
		"!dist/**/*.spec.*",
		"!dist/__mocks__"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@icpctools/contest-api": "workspace:*",
		"mode-watcher": "^1.1.0",
		"mpegts.js": "^1.8.0",
		"video.js": "^8.24.0",
		"videojs-mpegtsjs": "^1.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.13.4",
		"jsdom": "^28.1.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.11"
	}
}
