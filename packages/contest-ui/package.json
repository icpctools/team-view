{
	"name": "@icpctools/contest-ui",
	"version": "0.7.0-next",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"publishConfig": {
		"provenance": true,
		"access": "public"
	},
	"typesVersions": {
		"*": {
			"*": [
				"./src/index.ts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./Banner": {
			"types": "./dist/Banner.svelte.d.ts",
			"svelte": "./dist/Banner.svelte"
		},
		"./Clock": {
			"types": "./dist/Clock.svelte.d.ts",
			"svelte": "./dist/Clock.svelte"
		},
		"./Image": {
			"types": "./dist/Image.svelte.d.ts",
			"svelte": "./dist/Image.svelte"
		},
		"./FloorMap": {
			"types": "./dist/FloorMap.svelte.d.ts",
			"svelte": "./dist/FloorMap.svelte"
		},
		"./JudgementType": {
			"types": "./dist/JudgementType.svelte.d.ts",
			"svelte": "./dist/JudgementType.svelte"
		},
		"./Photo": {
			"types": "./dist/Photo.svelte.d.ts",
			"svelte": "./dist/Photo.svelte"
		},
		"./Problem": {
			"types": "./dist/Problem.svelte.d.ts",
			"svelte": "./dist/Problem.svelte"
		},
		"./ScoreboardRowUI": {
			"types": "./dist/ScoreboardRowUI.svelte.d.ts",
			"svelte": "./dist/ScoreboardRowUI.svelte"
		},
		"./ScoreboardHeader": {
			"types": "./dist/ScoreboardHeader.svelte.d.ts",
			"svelte": "./dist/ScoreboardHeader.svelte"
		},
		"./Video": {
			"types": "./dist/Video.svelte.d.ts",
			"svelte": "./dist/Video.svelte"
		},
		"./Logo": {
			"types": "./dist/Logo.svelte.d.ts",
			"svelte": "./dist/Logo.svelte"
		},
		"./Person": {
			"types": "./dist/Person.svelte.d.ts",
			"svelte": "./dist/Person.svelte"
		}
	},
	"scripts": {
		"test": "vitest",
		"build": "svelte-package",
		"watch": "svelte-package -w",
		"svelte:check": "svelte-check --tsconfig ./tsconfig.json",
		"publish:next": "pnpm publish  --registry=https://registry.npmjs.org/ --no-git-tag-version --new-version 0.0.1-\"$(date +%s)\""
	},
	"files": [
		"dist",
		"!dist/**/*.spec.*",
		"tsconfig.json"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.1.0",
		"@icpctools/contest-api": "workspace:*",
		"mpegts.js": "1.8.0",
		"video.js": "^8.23.6",
		"videojs-mpegtsjs": "^1.0.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/adapter-node": "^5.5.2",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24.10.11",
		"jsdom": "^28.0.0",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^6.4.1",
		"vitest": "^2.1.9"
	}
}
