{
	"compilerOptions": {
		"module": "esnext",
		"target": "esnext",
		"sourceMap": false,
		"moduleResolution": "bundler",
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true,

		"paths": {
			"/@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.d.ts", "src/**/*.ts", "src/**/*.svelte", "../../types/**/*.d.ts"]
}
