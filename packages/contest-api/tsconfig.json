{
	"compilerOptions": {
		"module": "esnext",
		"target": "esnext",
		"sourceMap": false,
		"moduleResolution": "bundler",
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"resolveJsonModule": true,

		"lib": ["esnext", "dom"],

		"paths": {
			"/@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "src/contest-types-*.ts", "scripts"]
}
