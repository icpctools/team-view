{
	"name": "@icpctools/contest-api",
	"version": "0.8.0-next",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/icpctools/team-view.git",
		"directory": "packages/contest-api"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"publishConfig": {
		"provenance": true,
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
