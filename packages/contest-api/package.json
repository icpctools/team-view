	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/contest-types"
	],
	"devDependencies": {
		"@types/node": "^24.13.4",
		"tsx": "^4.23.13",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	}
}
